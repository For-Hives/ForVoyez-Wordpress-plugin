{
	"name": "forvoyez-auto-alt-text-for-images",
	"description": "*this is a plugin for the [Forvoyez](https://forvoyez.com) platform*",
	"version": "1.1.45",
	"private": false,
	"scripts": {
		"precommit": "lint-staged",
		"prettier": "prettier --write .",
		"lint": "eslint . && composer run lint",
		"lint:fix": "eslint --fix . && composer run fix",
		"format": "prettier --write . && composer run format",
		"format:check": "prettier --check .",
		"phpcs": "composer run phpcs",
		"phpcbf": "composer run phpcbf",
		"build:css": "tailwindcss -c tailwind.config.js -i assets/src/admin-tailwind.css -o assets/css/admin-tailwind.css --minify",
		"watch:css": "tailwindcss -c tailwind.config.js -i assets/src/admin-tailwind.css -o assets/css/admin-tailwind.css --watch"
	},
	"lint-staged": {
		"*.js": [
			"prettier --write",
			"eslint --fix"
		],
		"*.php": [
			"composer run phpcbf",
			"composer run phpcs"
		],
		"*.json": "prettier --write",
		"*.css": "prettier --write"
	},
	"devDependencies": {
		"@prettier/plugin-php": "^0.22.2",
		"eslint": "8.57.1",
		"eslint-config-prettier": "9.1.2",
		"eslint-plugin-perfectionist": "2.11.0",
		"eslint-plugin-prettier": "5.5.7",
		"husky": "9.1.7",
		"lint-staged": "15.5.2",
		"prettier": "^3.3.3",
		"prettier-plugin-tailwindcss": "0.6.5",
		"tailwindcss": "3.4.19"
	},
	"engines": {
		"node": "20 || >=22"
	},
	"overrides": {
		"flat-cache": "^4.0.1",
		"minimatch": "^11.0.1",
		"yaml": "^2.8.3"
	}
}
