<?xml version="1.0"?>
<ruleset name="WordPress Plugin Custom Coding Standards">
    <description>Custom coding standards for WordPress plugins, aligned with Prettier</description>

    <file>.</file>
    <exclude-pattern>/vendor/</exclude-pattern>
    <exclude-pattern>/node_modules/</exclude-pattern>
    <exclude-pattern>/tests/</exclude-pattern>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <config name="minimum_wp_version" value="5.6"/>

    <!-- WordPress Core Rules -->
    <rule ref="WordPress-Core">
        <!-- Exclusions to align with Prettier -->
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
        <exclude name="WordPress.PHP.StrictInArray.MissingTrueStrict"/>
        <exclude name="Universal.Operators.StrictComparisons.LooseEqual"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames.classFound"/>
        <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>
        <exclude name="Universal.Operators.DisallowShortTernary.Found"/>
        <exclude name="Generic.Files.LineLength.MaxExceeded"/>
        <exclude name="Generic.Files.LineLength.TooLong"/>
        <exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
        <exclude name="WordPress.WhiteSpace.OperatorSpacing"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>

        <!-- Layout is owned by Prettier (`npm run format`, .prettierrc.js with
             @prettier/plugin-php): no spaces inside parentheses or brackets,
             short arrays, no alignment, multi-line PHP blocks in templates.
             These sniffs contradict its output, so they are not checked. -->
        <exclude name="PEAR.Functions.FunctionCallSignature"/>
        <exclude name="WordPress.WhiteSpace.ControlStructureSpacing"/>
        <exclude name="WordPress.WhiteSpace.CastStructureSpacing"/>
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
        <exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions"/>
        <exclude name="Generic.Formatting.MultipleStatementAlignment"/>
        <exclude name="Generic.WhiteSpace.ArbitraryParenthesesSpacing"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>
        <exclude name="Universal.WhiteSpace.DisallowInlineTabs"/>
        <exclude name="NormalizedArrays.Arrays.ArrayBraceSpacing"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
        <exclude name="Squiz.ControlStructures.ControlSignature"/>
        <exclude name="Squiz.PHP.EmbeddedPhp"/>
    </rule>

    <!-- Indentation Configuration -->
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="indent" value="4"/>
            <property name="tabIndent" value="true"/>
        </properties>
    </rule>

    <!-- Use of tabs -->
    <rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <properties>
            <property name="tabIndent" value="true"/>
        </properties>
    </rule>

    <!-- Brace style -->
    <rule ref="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>

    <!-- Single quotes -->
    <rule ref="Squiz.Strings.DoubleQuoteUsage.NotRequired"/>

    <!-- Internationalization rules -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="auto-alt-text-for-images"/>
            </property>
        </properties>
    </rule>

    <!-- PHP version -->
    <config name="testVersion" value="8.0-"/>
</ruleset>